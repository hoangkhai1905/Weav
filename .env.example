# ==================================================
# WEAV - Development Environment
# ==================================================

APP_ENV=development

# ---------- Supabase (disabled) ----------
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# ---------- Neon PostgreSQL (pooled) ----------
# Use each database's pooled endpoint from Neon; the hostname contains "-pooler".
# Keep one Neon database/project per service.

# Identity database
IDENTITY_DB_HOST=
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=
IDENTITY_DB_USERNAME=
IDENTITY_DB_PASSWORD=
IDENTITY_DB_SSL_MODE=require
IDENTITY_DB_CHANNEL_BINDING=require

# Workspace database
WORKSPACE_DB_HOST=
WORKSPACE_DB_PORT=5432
WORKSPACE_DB_NAME=
WORKSPACE_DB_USERNAME=
WORKSPACE_DB_PASSWORD=
WORKSPACE_DB_SSL_MODE=require
WORKSPACE_DB_CHANNEL_BINDING=require
CREDENTIAL_ENCRYPTION_KEY=

# Workflow database
WORKFLOW_DB_HOST=
WORKFLOW_DB_PORT=5432
WORKFLOW_DB_NAME=
WORKFLOW_DB_USERNAME=
WORKFLOW_DB_PASSWORD=
WORKFLOW_DB_SSL_MODE=require
WORKFLOW_DB_CHANNEL_BINDING=require

# Bot database
BOT_DB_HOST=
BOT_DB_PORT=5432
BOT_DB_NAME=
BOT_DB_USERNAME=
BOT_DB_PASSWORD=
BOT_DB_SSL_MODE=require
BOT_DB_CHANNEL_BINDING=require

# Notification database
NOTIFICATION_DB_HOST=
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_DB_SSL_MODE=require
NOTIFICATION_DB_CHANNEL_BINDING=require

# ---------- JWT - WEAV Backend ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Aiven Valkey ----------
VALKEY_URL=

# ---------- RabbitMQ ----------
# Used when running services directly on host.
# Docker Compose overrides this to "rabbitmq".
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- AI Providers ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Identity Google login callback (must match Google Cloud Console exactly).
# The OAuth, SMTP/OTP and avatar variables below are planned configuration;
# runtime wiring will be added during the corresponding Identity milestone.
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/oauth/google/callback

# ---------- Identity email OTP / Gmail SMTP ----------
# Gmail: use your full Google email as SMTP_USERNAME and its App Password as SMTP_PASSWORD.
# SMTP_FROM_ADDRESS must be the same email as SMTP_USERNAME or a verified Gmail send-as alias.
# Port 587 uses STARTTLS; implicit SSL stays disabled. Keep real secrets in your local .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH_ENABLED=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLED=false
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Weav
# Generate a separate random secret (at least 32 bytes); do not reuse JWT secrets.
OTP_HMAC_SECRET=

# ---------- Identity avatar storage / Cloudflare R2 (S3-compatible) ----------
# Copy the bucket S3 API endpoint from Cloudflare R2; use region auto.
# Example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (use the dashboard endpoint for jurisdiction-specific buckets).
# Do not use an r2.dev public URL or custom image domain as the S3 API endpoint.
# Fill the bucket name and R2 S3 Access Key ID / Secret Access Key with Object Read & Write for that bucket.
AVATAR_S3_ENDPOINT=
AVATAR_S3_REGION=auto
AVATAR_S3_BUCKET=
AVATAR_S3_ACCESS_KEY_ID=
AVATAR_S3_SECRET_ACCESS_KEY=
# Use path-style requests against the configured R2 account endpoint.
AVATAR_S3_PATH_STYLE_ACCESS=true
