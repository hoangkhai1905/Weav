# ==================================================
# WEAV - Development Environment
# ==================================================

APP_ENV=development

# ---------- Supabase ----------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------- PostgreSQL / Supabase ----------
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSL_MODE=require

# ---------- JWT - WEAV Backend ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Aiven Valkey ----------
VALKEY_URL=

# ---------- RabbitMQ ----------
# Used when running services directly on host.
# Docker Compose overrides this to "rabbitmq".
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- AI Providers ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=