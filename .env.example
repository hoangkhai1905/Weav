# ==================================================
# WEAV - Development Environment
# ==================================================

APP_ENV=development

# ---------- Supabase (disabled) ----------
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# ---------- Neon PostgreSQL (pooled) ----------
# Use each database's pooled endpoint from Neon; the hostname contains "-pooler".
# Keep one Neon database/project per service.

# Identity database
IDENTITY_DB_HOST=
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=
IDENTITY_DB_USERNAME=
IDENTITY_DB_PASSWORD=
IDENTITY_DB_SSL_MODE=require
IDENTITY_DB_CHANNEL_BINDING=require

# Workspace database
WORKSPACE_DB_HOST=
WORKSPACE_DB_PORT=5432
WORKSPACE_DB_NAME=
WORKSPACE_DB_USERNAME=
WORKSPACE_DB_PASSWORD=
WORKSPACE_DB_SSL_MODE=require
WORKSPACE_DB_CHANNEL_BINDING=require
CREDENTIAL_ENCRYPTION_KEY=

# Workflow database
WORKFLOW_DB_HOST=
WORKFLOW_DB_PORT=5432
WORKFLOW_DB_NAME=
WORKFLOW_DB_USERNAME=
WORKFLOW_DB_PASSWORD=
WORKFLOW_DB_SSL_MODE=require
WORKFLOW_DB_CHANNEL_BINDING=require

# Bot database
BOT_DB_HOST=
BOT_DB_PORT=5432
BOT_DB_NAME=
BOT_DB_USERNAME=
BOT_DB_PASSWORD=
BOT_DB_SSL_MODE=require
BOT_DB_CHANNEL_BINDING=require

# Notification database
NOTIFICATION_DB_HOST=
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_DB_SSL_MODE=require
NOTIFICATION_DB_CHANNEL_BINDING=require

# ---------- JWT - WEAV Backend ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Aiven Valkey ----------
VALKEY_URL=

# ---------- RabbitMQ ----------
# Used when running services directly on host.
# Docker Compose overrides this to "rabbitmq".
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- AI Providers ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=