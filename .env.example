# ==================================================
# WEAV - Development Environment
# ==================================================

APP_ENV=development

# Browser origins allowed to access the API Gateway (comma-separated, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
# Workspace -> Identity directory upstream; override when using Identity from a separate development stack.
IDENTITY_SERVICE_URL=http://identity-service:8080
# API Gateway -> Identity upstream. The `identity-edge` alias on the `edge` network makes Identity
# see the gateway's pinned IP, which is the only peer whose X-Forwarded-For it trusts.
GATEWAY_IDENTITY_SERVICE_URL=http://identity-edge:8080
# Keep the OCR bypass false except for explicit local development testing.
OCR_ALLOW_UNAUTHENTICATED_DEV=false
# API Gateway OCR upstream. compose.dev.yml pins the in-stack URL; compose.colab-ocr.dev.yml
# requires this value (set it to the Colab HTTPS tunnel when using that overlay).
OCR_SERVICE_URL=http://ocr-service:8000
# API Gateway trusted proxy hops (0-10). 0 disables trustProxy; set to the proxy count behind a load balancer.
GATEWAY_TRUST_PROXY_HOPS=0
# API Gateway public webhook ingress limit per window per endpoint key.
GATEWAY_WEBHOOK_RATE_LIMIT=60
# API Gateway assistant chat limit per window per user (each turn can cost several model calls).
GATEWAY_ASSISTANT_RATE_LIMIT=20
# Shared throttler storage (redis:// or rediss:// Valkey URL) so limits hold across gateway replicas. Empty keeps in-memory counters.
GATEWAY_THROTTLER_REDIS_URL=

# ---------- Supabase (disabled) ----------
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# ---------- Neon PostgreSQL (pooled) ----------
# Use each database's pooled endpoint from Neon; the hostname contains "-pooler".
# Keep one Neon database/project per service.

# Identity database
IDENTITY_DB_HOST=
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=
IDENTITY_DB_USERNAME=
IDENTITY_DB_PASSWORD=
IDENTITY_DB_SSL_MODE=require
IDENTITY_DB_CHANNEL_BINDING=require

# Workspace database
WORKSPACE_DB_HOST=
WORKSPACE_DB_PORT=5432
WORKSPACE_DB_NAME=
WORKSPACE_DB_USERNAME=
WORKSPACE_DB_PASSWORD=
WORKSPACE_DB_SSL_MODE=require
WORKSPACE_DB_CHANNEL_BINDING=require
# Required Base64-encoded 32-byte AES-256 key; keep the value in a local secret store.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
# Optional retired keys still needed to decrypt stored credentials: version:base64key,version:base64key (rotation: move the old key+version here, set a new key + version).
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# Workspace Connection Google OAuth. Use credentials from the intended Google OAuth web client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8082/oauth/google/callback
GOOGLE_OAUTH_FRONTEND_RETURN_URL=http://localhost:5173/connections
GOOGLE_OAUTH_STATE_TTL=PT10M
# How long the Google callback code waits for the signed-in user to complete the connection (max PT10M).
GOOGLE_OAUTH_COMPLETION_TTL=PT5M

# Workspace to Workflow usage check; this key must also be set as Workflow's incoming internal key.
WORKFLOW_SERVICE_URL=http://workflow-service:8080
WORKFLOW_CONNECT_TIMEOUT=3s
WORKFLOW_READ_TIMEOUT=5s
WORKFLOW_INTERNAL_SERVICE_KEY=

# Workflow database
WORKFLOW_DB_HOST=
WORKFLOW_DB_PORT=5432
WORKFLOW_DB_NAME=
WORKFLOW_DB_USERNAME=
WORKFLOW_DB_PASSWORD=
WORKFLOW_DB_SSL_MODE=require
WORKFLOW_DB_CHANNEL_BINDING=require

# Workflow runtime: service URLs are nonsecret; keys stay empty here and must be provisioned locally.
WORKSPACE_SERVICE_URL=http://workspace-service:8080
WORKSPACE_CONNECT_TIMEOUT=3s
WORKSPACE_READ_TIMEOUT=5s

# Workflow admission and webhook ingress bounds
WORKFLOW_EXECUTION_INPUT_MAX_BYTES=1048576
WORKFLOW_EXECUTION_INPUT_MAX_DEPTH=32
WORKFLOW_WEBHOOK_RATE_LIMIT_REQUESTS_PER_WINDOW=6000
WORKFLOW_WEBHOOK_RATE_LIMIT_WINDOW=1m
# Public HTTPS base URL of the gateway, for example a Cloudflare quick tunnel URL. Telegram sends bot updates
# to <base>/api/v1/webhooks/telegram/<key>; leave empty and trigger.telegram stays unavailable.
WORKFLOW_PUBLIC_BASE_URL=
# Call timeout for Telegram setWebhook/deleteWebhook; they run inside the publish transaction, so keep it short.
WORKFLOW_TELEGRAM_CONTROL_TIMEOUT=10s

# Durable outbox and schedule scanner
WORKFLOW_EXECUTION_OUTBOX_BATCH_SIZE=50
WORKFLOW_EXECUTION_OUTBOX_POLL_INTERVAL=1000
WORKFLOW_EXECUTION_OUTBOX_INITIAL_DELAY=1000
WORKFLOW_EXECUTION_OUTBOX_LEASE_DURATION=30s
WORKFLOW_EXECUTION_OUTBOX_CONFIRM_TIMEOUT=5s
WORKFLOW_EXECUTION_OUTBOX_MAX_RETRY_DELAY=60s
WORKFLOW_SCHEDULE_SCANNER_ENABLED=true
WORKFLOW_SCHEDULE_SCANNER_BATCH_SIZE=100
WORKFLOW_SCHEDULE_SCANNER_POLL_INTERVAL_MS=1000
WORKFLOW_SCHEDULE_SCANNER_INITIAL_DELAY_MS=1000
WORKFLOW_SCHEDULE_FAILURE_BACKOFF_MS=30000

# Execution worker and bounded node concurrency; enable only for an intended worker deployment.
WORKFLOW_EXECUTION_WORKER_ENABLED=false
WORKFLOW_EXECUTION_WORKER_OWNER=workflow-worker
WORKFLOW_EXECUTION_WORKER_LEASE_DURATION=60s
WORKFLOW_EXECUTION_WORKER_HEARTBEAT_INTERVAL=15s
WORKFLOW_EXECUTION_WORKER_CONFIRM_TIMEOUT=5s
WORKFLOW_EXECUTION_WORKER_REDELIVERY_DELAY=5000
WORKFLOW_EXECUTION_WORKER_MAX_REDELIVERIES=3
# Concurrent execution consumers per workflow pod (prefetch stays 1); size with WORKFLOW_DB_POOL_SIZE
WORKFLOW_EXECUTION_WORKER_CONCURRENCY_MIN=2
WORKFLOW_EXECUTION_WORKER_CONCURRENCY_MAX=4
# Scheduler threads for scanners and outbox publishers
WORKFLOW_SCHEDULER_POOL_SIZE=4
# Hikari max pool for workflow-service (Neon pooled endpoint)
WORKFLOW_DB_POOL_SIZE=10
WORKFLOW_EXECUTION_MAX_CONCURRENT_NODES=4
# Days of finished run history to keep; 0 keeps everything
WORKFLOW_EXECUTION_RETENTION_DAYS=0
WORKFLOW_EXECUTION_EXECUTOR_THREADS=8
WORKFLOW_EXECUTION_EXECUTOR_QUEUE_SIZE=128
WORKFLOW_EXECUTION_TIMER_THREADS=2
WORKFLOW_EXECUTION_RECOVERY_BATCH_SIZE=50
WORKFLOW_EXECUTION_RECOVERY_POLL_INTERVAL=30s
WORKFLOW_EXECUTION_RECOVERY_INITIAL_DELAY=30s
WORKFLOW_EXECUTION_RECOVERY_QUEUED_DELIVERY_AGE=1m
WORKFLOW_EXECUTION_RECOVERY_OUTBOX_COOLDOWN=1m

# Outbound HTTP request/response and timeout bounds
WORKFLOW_HTTP_CONNECT_TIMEOUT=5s
WORKFLOW_HTTP_CALL_TIMEOUT=30s
WORKFLOW_HTTP_MAX_REQUEST_BYTES=1048576
WORKFLOW_HTTP_MAX_RESPONSE_BYTES=1048576
WORKFLOW_HTTP_MAX_HEADER_BYTES=65536

# OCR runtime is disabled until the private URL, signing material and all verification gates are approved.
WORKFLOW_OCR_ENABLED=false
WORKFLOW_OCR_URL_SOURCE_ENABLED=false
WORKFLOW_OCR_ARTIFACT_SOURCE_ENABLED=false
WORKFLOW_OCR_SERVICE_CLAIMS_VERIFIED=false
WORKFLOW_OCR_URL_ALLOWLIST_VERIFIED=false
WORKFLOW_OCR_ARTIFACT_RESOLVER_VERIFIED=false
OCR_SERVICE_PRIVATE_URL=http://ocr-service:8000
WORKFLOW_OCR_SIGNING_KEY_ID=
WORKFLOW_OCR_SIGNING_KEY_LOCATION=
WORKFLOW_OCR_CONNECT_TIMEOUT=5s
WORKFLOW_OCR_READ_TIMEOUT=30s
WORKFLOW_OCR_TOKEN_LIFETIME=60s
WORKFLOW_OCR_MAX_RESPONSE_BYTES=1048576

# Notification database
NOTIFICATION_DB_HOST=
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_DB_SSL_MODE=require
NOTIFICATION_DB_CHANNEL_BINDING=require

# Direct non-pooled PostgreSQL URL for notification migrations only; not needed by the runtime.
NOTIFICATION_MIGRATION_URL=
NOTIFICATION_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
NOTIFICATION_EXPO_ENABLED=false
EXPO_ACCESS_TOKEN=
NOTIFICATION_EXCHANGE=weav.events
NOTIFICATION_QUEUE=notification-service.execution-events
NOTIFICATION_DLQ=notification-service.execution-events.dlq
# Quorum queue actually consumed; blank = <NOTIFICATION_QUEUE>.v2 (the old classic queue is drained, then deleted by an operator).
NOTIFICATION_QUEUE_V2=
# Redeliveries before the broker dead-letters a failing message to the DLQ.
NOTIFICATION_DELIVERY_LIMIT=10
# Keep draining the old classic queue; set false after it is deleted.
NOTIFICATION_LEGACY_DRAIN=true
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_MS=1000
NOTIFICATION_RETRY_MAX_MS=300000
NOTIFICATION_TIMEOUT_MS=10000
NOTIFICATION_LEASE_MS=60000
NOTIFICATION_POLL_MS=1000
# Optional HTTPS base URL (unset to omit execution links in Telegram).
# NOTIFICATION_DETAIL_BASE_URL=https://weav.example

# ---------- JWT - WEAV Backend ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=weav-identity
JWT_AUDIENCE=weav-api
JWT_CLOCK_SKEW=30s
# Access-token algorithm: HS256 (shared JWT_ACCESS_SECRET) or RS256 (identity signs with a private key, verifiers use its JWKS).
# For RS256 run `node scripts/identity-dev-keys.mjs`; compose mounts tmp/service-keys/identity read-only.
JWT_ACCESS_ALG=HS256
JWT_SIGNING_KEY_ID=

# ---------- Workspace service-to-service and authorization ----------
# Workspace sends IDENTITY_INTERNAL_SERVICE_KEY to Identity's internal directory
# API. WEAV_INTERNAL_SERVICE_KEY (at least 32 characters when set) protects Workspace's Workflow-facing endpoint.
IDENTITY_INTERNAL_SERVICE_KEY=
WEAV_INTERNAL_SERVICE_KEY=
IDENTITY_CONNECT_TIMEOUT=3s
IDENTITY_READ_TIMEOUT=5s
WORKSPACE_AUTHORIZATION_CACHE_TTL=PT5M
# Workspace reads REDIS_URL; use the same URI as VALKEY_URL when sharing Valkey.
REDIS_URL=

# ---------- Aiven Valkey ----------
VALKEY_URL=

# ---------- RabbitMQ ----------
# Used when running services directly on host.
# Docker Compose overrides this to "rabbitmq".
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# Same names in every service. Optional: RABBITMQ_VHOST (default /) and
# RABBITMQ_TLS_ENABLED (default false); legacy aliases RABBITMQ_SSL_ENABLED and
# RABBITMQ_TLS still work.
RABBITMQ_MANAGEMENT_PORT=15672
# Optional per-service broker users (X-9). Empty = the service uses the shared
# RABBITMQ_USERNAME/RABBITMQ_PASSWORD above (which is also the admin for the script).
# Set BOTH username and password per service (e.g. weav-workflow), then run: node scripts/rabbitmq-provision-users.mjs
IDENTITY_RABBITMQ_USERNAME=
IDENTITY_RABBITMQ_PASSWORD=
WORKSPACE_RABBITMQ_USERNAME=
WORKSPACE_RABBITMQ_PASSWORD=
WORKFLOW_RABBITMQ_USERNAME=
WORKFLOW_RABBITMQ_PASSWORD=
NOTIFICATION_RABBITMQ_USERNAME=
NOTIFICATION_RABBITMQ_PASSWORD=

# ---------- AI Providers ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------- Google OAuth ----------
# Leave blank for automatic disabled/enable behavior based on credentials;
# set false to force OAuth off or true to require complete validation.
GOOGLE_OAUTH_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Identity Google login callback (must match Google Cloud Console exactly).
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/oauth/google/callback
# Browser return target and exact allowed origin (non-secret local defaults).
OAUTH_WEB_RETURN_TARGET_URI=http://localhost:5173/auth/callback
OAUTH_WEB_ALLOWED_ORIGIN=http://localhost:5173

# ---------- Identity email OTP / Gmail SMTP ----------
# Gmail: use your full Google email as SMTP_USERNAME and its App Password as SMTP_PASSWORD.
# SMTP_FROM_ADDRESS must be the same email as SMTP_USERNAME or a verified Gmail send-as alias.
# Port 587 uses STARTTLS; implicit SSL stays disabled. Keep real secrets in your local .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH_ENABLED=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLED=false
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Weav
# Generate a separate random secret (at least 32 bytes); do not reuse JWT secrets.
OTP_HMAC_SECRET=

# ---------- Identity avatar storage / Cloudflare R2 (S3-compatible) ----------
# Copy the bucket S3 API endpoint from Cloudflare R2; use region auto.
# Example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (use the dashboard endpoint for jurisdiction-specific buckets).
# Do not use an r2.dev public URL or custom image domain as the S3 API endpoint.
# Fill the bucket name and R2 S3 Access Key ID / Secret Access Key with Object Read & Write for that bucket.
AVATAR_S3_ENDPOINT=
AVATAR_S3_REGION=auto
AVATAR_S3_BUCKET=
AVATAR_S3_ACCESS_KEY_ID=
AVATAR_S3_SECRET_ACCESS_KEY=
# Use path-style requests against the configured R2 account endpoint.
AVATAR_S3_PATH_STYLE_ACCESS=true
AVATAR_S3_KEY_PREFIX=avatars
AVATAR_S3_SIGNED_URL_TTL=5m
AVATAR_S3_CLEANUP_INTERVAL_MS=30000

# AI Service (DeepSeek). Leave blank to keep AI not-ready.
# Setup: run `node scripts/ai-dev-keys.mjs` once, set the key and model, then turn on the Workflow flags below.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Holds public/ (JWKS, mounted into ai-service) and private/ (key, mounted into workflow-service).
WEAV_SERVICE_KEYS_DIR=./tmp/service-keys
WORKFLOW_AI_ENABLED=false
WORKFLOW_AI_GENERATION_ENABLED=false
# Max AI calls (nodes + generation) per workspace per UTC day; 0 = unlimited (dev). Set a positive value in production.
WORKFLOW_AI_DAILY_LIMIT_PER_WORKSPACE=0
# AI assistant chat spike (ai-service POST /v1/assistant/chat, gateway POST /api/v1/assistant/chat). Off: the route does not exist.
# REQUIRES identity to sign access tokens with RS256 (JWT_ACCESS_ALG=RS256): user tokens are verified against identity's JWKS, and ai-service logs a startup warning if the JWKS is unreachable or has no RSA keys; JWT_ISSUER / JWT_AUDIENCE / JWT_CLOCK_SKEW are shared with the gateway.
AI_ASSISTANT_ENABLED=false
# workflow-service public API the assistant tools call with the user's own token.
AI_WORKFLOW_API_URL=http://workflow-service:8080
AI_ASSISTANT_MAX_TOKENS=1024
# Max concurrent assistant streams per replica (separate from AI_MAX_CONCURRENCY, so chat cannot starve workflow AI calls).
AI_ASSISTANT_MAX_CONCURRENT=4
AI_ASSISTANT_RATE_LIMIT_PER_MINUTE=20
# AI assistant storage: Neon database ai_db, schema ai (conversations, messages, daily usage). Empty AI_DB_HOST = no storage.
AI_DB_HOST=
AI_DB_PORT=5432
AI_DB_NAME=ai_db
AI_DB_USERNAME=
AI_DB_PASSWORD=
AI_DB_SSL_MODE=require
AI_DB_CHANNEL_BINDING=require
# Direct non-pooled PostgreSQL URL for ai-service migrations only (pnpm --dir services/ai-service db:migrate); not needed by the runtime.
# It MUST end with ?schema=ai (or &schema=ai) so the _prisma_migrations table lands in schema ai.
AI_MIGRATION_URL=
# Days an untouched conversation is kept, and days a daily usage counter is kept.
AI_ASSISTANT_RETENTION_DAYS=30
AI_ASSISTANT_USAGE_RETENTION_DAYS=90
JWT_JWKS_URI=http://identity-service:8080/.well-known/jwks.json
# X-7: when true, Workspace's /internal/workspaces/** accepts only Workflow's scoped service JWTs (static WEAV_INTERNAL_SERVICE_KEY rejected). Needs the JWKS from scripts/ai-dev-keys.mjs.
WORKSPACE_INTERNAL_REQUIRE_SERVICE_JWT=false
