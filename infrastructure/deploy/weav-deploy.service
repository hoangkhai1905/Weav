# Install on the demo host: sudo cp infrastructure/deploy/weav-deploy.* /etc/systemd/system/
#   && sudo systemctl daemon-reload && sudo systemctl enable --now weav-deploy.timer
# Logs: journalctl -u weav-deploy -f
[Unit]
Description=Weav demo: pull CI-built images from GHCR and deploy
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=azureuser
Environment=WEAV_SECRETS_DIR=/home/azureuser/weav-secrets
Environment=WEAV_REPO_DIR=/home/azureuser/Weav
ExecStart=/bin/bash /home/azureuser/Weav/scripts/deploy-pull.sh
