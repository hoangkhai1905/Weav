# Notifications use HTTP unless mock mode is explicitly selected.
VITE_API_MODE=http
# VITE_API_GATEWAY_URL also remains supported and takes precedence if already set.
VITE_API_BASE_URL=http://localhost:3000
# Public base for webhook URLs shown after publish (e.g. a cloudflared tunnel to the gateway). Defaults to the API base.
VITE_PUBLIC_WEBHOOK_BASE_URL=
# Google OAuth M3 uses the Identity web transport directly for PKCE + cookies.
VITE_IDENTITY_SERVICE_URL=http://localhost:8081
