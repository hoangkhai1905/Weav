FROM eclipse-temurin:25-jdk

WORKDIR /app
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
COPY src/ src/
COPY --from=contracts . /packages/contracts/
# Node config schemas are packaged as classpath resources (pom.xml).
COPY --from=workflow-schema . /packages/workflow-schema/
RUN chmod +x mvnw && ./mvnw -q -DskipTests package

ENTRYPOINT ["java", "-jar", "target/workflow-service-0.0.1-SNAPSHOT.jar"]
