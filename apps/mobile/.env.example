# WEAV Mobile App Environment Config
EXPO_PUBLIC_API_MODE=http
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Set API_MODE=mock for the offline demo. On a physical device, configure the gateway's LAN URL.
# Public HTTPS URL of identity-service for Google sign-in (browser leg), e.g. a cloudflared tunnel. Empty hides the button.
EXPO_PUBLIC_IDENTITY_URL=
