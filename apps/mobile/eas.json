{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "http",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.weav.id.vn",
        "EXPO_PUBLIC_IDENTITY_URL": "https://api.weav.id.vn"
      }
    }
  }
}
