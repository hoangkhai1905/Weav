{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Service V1 definition draft",
  "description": "The draft definition envelope and supported node configuration shapes. Publish completeness and graph semantics are enforced by the Java domain validator.",
  "$comment": "The Java validator additionally enforces the 1 MiB UTF-8 size limit, 32-container JSON depth limit, unique identifiers, node and edge count limits, credential safety, connection UUID rules, complete publish configuration, schedule validation, DAG constraints, trigger rules, reachability, and publish-time mapping grammar and static upstream references. This schema intentionally does not require publish-complete node fields so incomplete drafts remain editable.",
  "type": "object",
  "required": [
    "schemaVersion",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "nodes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "type": {
          "type": "string",
          "enum": [
            "trigger.manual",
            "trigger.schedule",
            "trigger.webhook",
            "trigger.telegram",
            "http.request",
            "email.send",
            "google.sheets",
            "google.calendar",
            "google.drive",
            "telegram.send_message",
            "logic.condition",
            "ai.extract",
            "ai.classify",
            "ai.summarize",
            "ocr.extract",
            "logic.switch",
            "data.set",
            "ai.generate",
            "trigger.gmail",
            "weav.workflow",
            "trigger.workflow_event",
            "discord.send_message",
            "format.datetime",
            "format.text",
            "slack.send_message",
            "teams.send_message"
          ]
        },
        "config": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "trigger.manual"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "buttonLabel": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "trigger.schedule"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "cron": {
                    "type": "string"
                  },
                  "timezone": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "trigger.webhook"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "trigger.telegram"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "$ref": "#/$defs/connectionId"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "http.request"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "query": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "body": {},
                  "connectionId": {
                    "$ref": "#/$defs/connectionId"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "email.send"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "$ref": "#/$defs/connectionId"
                  },
                  "to": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "cc": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "bcc": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "replyTo": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "subject": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "bodyType": {
                    "type": "string",
                    "enum": [
                      "text",
                      "html"
                    ]
                  },
                  "senderName": {
                    "type": "string"
                  },
                  "replyToMessageId": {
                    "type": "string"
                  },
                  "attachments": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "google.sheets"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "$ref": "#/$defs/connectionId"
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "read",
                      "append",
                      "update",
                      "lookup"
                    ]
                  },
                  "spreadsheetId": {
                    "type": "string"
                  },
                  "range": {
                    "type": "string"
                  },
                  "values": {},
                  "lookupColumn": {
                    "type": "string"
                  },
                  "lookupValue": {},
                  "limit": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "valueInputOption": {
                    "type": "string",
                    "enum": [
                      "RAW",
                      "USER_ENTERED"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "google.calendar"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "$ref": "#/$defs/connectionId"
                  },
                  "calendarId": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "start": {
                    "type": "string"
                  },
                  "end": {
                    "type": "string"
                  },
                  "timeZone": {
                    "type": "string"
                  },
                  "attendees": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sendInvitations": {
                    "type": "boolean"
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "create",
                      "list"
                    ]
                  },
                  "timeMin": {
                    "type": "string",
                    "description": "list: window start (RFC 3339 date-time with offset, or a date). A date without a time means midnight UTC; an offset date-time is recommended."
                  },
                  "timeMax": {
                    "type": "string",
                    "description": "list: window end, after timeMin. A date without a time means midnight UTC; an offset date-time is recommended."
                  },
                  "maxResults": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "query": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "google.drive"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "$ref": "#/$defs/connectionId"
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "upload",
                      "list"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "file": {
                    "oneOf": [
                      {
                        "type": "object"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "mimeType": {
                    "type": "string"
                  },
                  "folderId": {
                    "type": "string"
                  },
                  "nameContains": {
                    "type": "string"
                  },
                  "pageSize": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "telegram.send_message"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "$ref": "#/$defs/connectionId"
                  },
                  "chatId": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "text": {
                    "type": "string"
                  },
                  "parseMode": {
                    "type": "string",
                    "enum": [
                      "none",
                      "HTML",
                      "MarkdownV2"
                    ]
                  },
                  "disableNotification": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "replyToMessageId": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "logic.condition"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "left": {},
                  "operator": {
                    "type": "string",
                    "enum": [
                      "eq",
                      "ne",
                      "gt",
                      "gte",
                      "lt",
                      "lte"
                    ]
                  },
                  "right": {},
                  "combinator": {
                    "type": "string",
                    "enum": [
                      "and",
                      "or"
                    ]
                  },
                  "conditions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "object",
                      "properties": {
                        "left": {},
                        "operator": {
                          "type": "string",
                          "enum": [
                            "eq",
                            "ne",
                            "gt",
                            "gte",
                            "lt",
                            "lte"
                          ]
                        },
                        "right": {}
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ai.extract"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "outputSchema": {
                    "type": "object"
                  },
                  "instructions": {
                    "type": "string"
                  },
                  "schemaDescription": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ai.classify"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ai.summarize"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "inputText": {
                    "type": "string"
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ocr.extract"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string"
                  },
                  "fileUrl": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "detectTables": {
                    "type": "boolean"
                  }
                },
                "not": {
                  "required": [
                    "artifactId",
                    "fileUrl"
                  ]
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "logic.switch"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "value": {},
                  "cases": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "data.set"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "fields": {
                    "type": "object",
                    "maxProperties": 100
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ai.generate"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "instructions": {
                    "type": "string"
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "trigger.gmail"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "$ref": "#/$defs/connectionId"
                  },
                  "query": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "pollIntervalMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1440
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "weav.workflow"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "run",
                      "pause",
                      "resume",
                      "status",
                      "list_failures",
                      "command"
                    ]
                  },
                  "workflow": {
                    "type": "string"
                  },
                  "input": {
                    "type": "object"
                  },
                  "limit": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "text": {
                    "type": "string"
                  },
                  "sender": {
                    "type": "string"
                  },
                  "allowedSenders": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "trigger.workflow_event"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "workflowIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "discord.send_message"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "$ref": "#/$defs/connectionId"
                  },
                  "content": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "format.datetime"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "now",
                      "add",
                      "subtract",
                      "format",
                      "convert"
                    ]
                  },
                  "value": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "amount": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "minutes",
                      "hours",
                      "days",
                      "weeks",
                      "months",
                      "years"
                    ]
                  },
                  "pattern": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "locale": {
                    "type": "string",
                    "enum": [
                      "vi",
                      "en"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "format.text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "upper",
                      "lower",
                      "trim",
                      "replace",
                      "split",
                      "join",
                      "truncate",
                      "number_format"
                    ]
                  },
                  "value": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "search": {
                    "type": "string"
                  },
                  "replacement": {
                    "type": "string"
                  },
                  "separator": {
                    "type": "string",
                    "maxLength": 16
                  },
                  "maxLength": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "decimals": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 6
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "locale": {
                    "type": "string",
                    "enum": [
                      "vi",
                      "en"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slack.send_message"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "connectionId": {
