{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weav notification event v2",
  "description": "Allowlisted internal notification events. Cross-field identity and workspace equality rules are additionally enforced by the Notification service.",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "producer",
    "actorUserId",
    "recipientUserIds",
    "workspaceId",
    "entity",
    "data"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": {
      "enum": [
        "workflow.created",
        "workflow.published",
        "workflow.paused",
        "workflow.resumed",
        "workflow.completed",
        "workflow.failed",
        "workspace.created",
        "workspace.renamed",
        "workspace.member_added",
        "workspace.member_removed",
        "workspace.member_permissions_updated",
        "workspace.member_left",
        "connection.connected",
        "connection.disabled",
        "connection.invalid",
        "identity.password_changed",
        "identity.password_reset",
        "identity.google_linked",
        "identity.google_unlinked"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": {
      "enum": ["workflow-service", "workspace-service", "identity-service"]
    },
    "actorUserId": {
      "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "recipientUserIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "workspaceId": {
      "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "entity": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["WORKFLOW", "EXECUTION", "WORKSPACE", "CONNECTION", "USER"]
        },
        "id": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    },
    "data": { "type": "object" }
  },
  "additionalProperties": false,
