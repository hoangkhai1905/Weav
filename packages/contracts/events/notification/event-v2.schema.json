    {
      "oneOf": [
        {
          "properties": {
            "eventType": { "const": "workflow.created" },
            "producer": { "const": "workflow-service" },
            "workspaceId": { "type": "string", "format": "uuid" },
            "entity": { "properties": { "kind": { "const": "WORKFLOW" } } },
            "data": {
              "type": "object",
              "required": ["workflowName"],
              "properties": {
                "workflowName": {
                  "type": "string",
