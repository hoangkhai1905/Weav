{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weav:node/telegram.send_message",
  "title": "Send Telegram message",
  "description": "Sends a text message to a Telegram chat.",
  "x-weav-node": {
    "type": "telegram.send_message",
    "category": "action",
    "label": "Send Telegram message",
    "sideEffect": true
  },
  "type": "object",
  "properties": {
    "connectionId": {
      "type": "string",
      "minLength": 1,
      "title": "Telegram bot connection",
      "description": "Telegram bot connection (token from @BotFather) used to send the message.",
      "x-weav-connection": {
        "provider": "TELEGRAM"
      }
    },
    "chatId": {
      "title": "Chat ID",
      "description": "Telegram chat that receives the message: a numeric chat id or an @channel username.",
      "x-weav-template": true,
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer"
        }
      ]
    },
    "text": {
      "type": "string",
      "title": "Message",
      "description": "Message text to send.",
      "x-weav-template": true,
      "minLength": 1
    }
  },
  "required": [
    "connectionId",
    "chatId",
    "text"
  ],
  "additionalProperties": false
}
