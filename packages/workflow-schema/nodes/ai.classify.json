{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weav:node/ai.classify",
  "title": "Classify with AI",
  "description": "Assigns content to one of the given categories using an AI model.",
  "x-weav-node": {
    "type": "ai.classify",
    "category": "ai",
    "label": "Classify with AI",
    "sideEffect": false
  },
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "title": "Content",
      "description": "Text to classify.",
      "x-weav-template": true,
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "title": "Categories",
      "description": "Allowed category names.",
      "items": {
        "type": "string"
      },
      "x-weav-template": true
    },
    "connectionId": {
      "type": "string",
      "minLength": 1,
      "title": "AI for this step",
      "description": "Your own OpenAI, Anthropic or Gemini connection. Leave empty to use the Weav default.",
      "x-weav-connection": {
        "provider": [
          "OPENAI",
          "ANTHROPIC",
          "GEMINI"
        ]
      }
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "title": "Model name",
      "description": "Optional model id at your provider, for example gpt-4o-mini. Needs an AI connection.",
      "x-weav-ui": {
        "advanced": true
      }
    }
  },
  "required": [
    "content"
  ],
  "additionalProperties": false
}
