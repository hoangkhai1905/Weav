{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weav:node/email.send",
  "title": "Send email",
  "description": "Sends an email through a connected Gmail account.",
  "x-weav-node": {
    "type": "email.send",
    "category": "action",
    "label": "Send email",
    "sideEffect": true
  },
  "type": "object",
  "properties": {
    "connectionId": {
      "type": "string",
      "minLength": 1,
      "title": "Connection",
      "description": "Gmail connection used to send the email.",
      "x-weav-connection": {
        "provider": "GMAIL"
      }
    },
    "to": {
      "title": "To",
      "description": "One recipient address or a list of recipient addresses.",
      "x-weav-template": true,
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "subject": {
      "type": "string",
      "title": "Subject",
      "description": "Email subject line.",
      "x-weav-template": true,
      "minLength": 1
    },
    "body": {
      "type": "string",
      "title": "Body",
      "description": "Email body text.",
      "x-weav-template": true
    }
  },
  "required": [
    "connectionId",
    "to",
    "subject",
    "body"
  ],
  "additionalProperties": false
}
