FROM python:3.12-slim-bookworm

# PaddlePaddle CPU cần OpenMP runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    libgomp1 \
    libgl1 \
    libglib2.0-0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# uv - pin đúng version team đang dùng
COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/

WORKDIR /app

ENV UV_LINK_MODE=copy
ENV PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock ./

# paddle: Paddle Inference (default manifest, model conversion). onnx: ONNX Runtime only, no paddlepaddle.
ARG OCR_RUNTIME=paddle
RUN case "$OCR_RUNTIME" in       paddle) uv sync --locked --extra paddle ;;       onnx) uv sync --locked ;;       *) echo "OCR_RUNTIME must be paddle or onnx" >&2; exit 1 ;;     esac
# Keep the installed runtime: a plain `uv run` would re-sync and drop the optional paddle extra.
ENV UV_NO_SYNC=1

COPY . .

CMD ["uv", "run", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]