generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/notification"
}
datasource db {
  provider = "postgresql"
  schemas = ["notification"]
}
enum NotificationProvider {
  TELEGRAM
  EXPO_PUSH
  @@schema("notification")
}
enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  @@schema("notification")
}
model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  inboxId String? @map("inbox_id") @db.Uuid
  executionId String? @map("execution_id") @db.Uuid
  sourceEventId String? @map("source_event_id") @db.Uuid
  provider NotificationProvider
  destination String @db.VarChar(512)
  eventType String @map("event_type") @db.VarChar(128)
  payload Json @db.JsonB
  status NotificationStatus @default(PENDING)
  retryCount Int @default(0) @map("retry_count")
  lastError Json? @map("last_error") @db.JsonB
  readAt DateTime? @map("read_at") @db.Timestamptz(3)
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  inbox NotificationInbox? @relation(fields: [inboxId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "notification_deliveries_inbox_id_user_id_fkey")
  @@unique([sourceEventId, userId, provider, destination], map: "notification_deliveries_event_recipient_key")
  @@index([userId, createdAt, id])
  @@index([userId, readAt, createdAt])
  @@index([status, scheduledAt])
  @@index([inboxId], map: "notification_deliveries_inbox_id_idx")
  @@map("notification_deliveries")
  @@schema("notification")
}

model NotificationInbox {
  id String @id @db.Uuid
  dedupKey String @unique(map: "notification_inbox_dedup_key_key") @map("dedup_key") @db.VarChar(128)
  sourceEventId String? @map("source_event_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(128)
  category String @db.VarChar(32)
  severity String @db.VarChar(16)
  workspaceId String? @map("workspace_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  executionId String? @map("execution_id") @db.Uuid
  content Json @db.JsonB
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt DateTime? @map("read_at") @db.Timestamptz(3)
  deliveries NotificationDelivery[]
  @@unique([sourceEventId, userId], map: "notification_inbox_source_event_id_user_id_key")
  @@unique([id, userId], map: "notification_inbox_id_user_id_key")
  @@index([userId, createdAt, id], map: "notification_inbox_user_id_created_at_id_idx")
  @@index([userId, readAt, createdAt], map: "notification_inbox_user_id_read_at_created_at_idx")
  @@map("notification_inbox")
  @@schema("notification")
}
