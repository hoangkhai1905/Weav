# Demo / production environment for compose.prod.yml. Placeholders only.
# Copy to ${WEAV_SECRETS_DIR}/prod.env (outside git, chmod 600) and replace every CHANGE_ME:
#   docker compose -f compose.prod.yml --env-file "$WEAV_SECRETS_DIR/prod.env" up -d
# Do not use "$" in values (compose would interpolate it); the generators below never emit one.
# Fixed values (public URLs, APP_ENV, AI flags, CORS, proxy hops) live in compose.prod.yml, not here.

# ---------- Secrets directory ----------
# Holds prod.env, service-keys/{identity,public,private,gateway}/ and cloudflared/creds.json.
WEAV_SECRETS_DIR=./tmp/prod

# ---------- Neon demo branch: pooled runtime hosts, one database per service ----------
# Host is the pooled endpoint (contains "-pooler"); each service uses its own schema (set in compose).
IDENTITY_DB_HOST=CHANGE_ME
IDENTITY_DB_NAME=CHANGE_ME
IDENTITY_DB_USERNAME=CHANGE_ME
IDENTITY_DB_PASSWORD=CHANGE_ME
WORKSPACE_DB_HOST=CHANGE_ME
WORKSPACE_DB_NAME=CHANGE_ME
WORKSPACE_DB_USERNAME=CHANGE_ME
WORKSPACE_DB_PASSWORD=CHANGE_ME
WORKFLOW_DB_HOST=CHANGE_ME
WORKFLOW_DB_NAME=CHANGE_ME
WORKFLOW_DB_USERNAME=CHANGE_ME
WORKFLOW_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_HOST=CHANGE_ME
NOTIFICATION_DB_NAME=CHANGE_ME
NOTIFICATION_DB_USERNAME=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
AI_DB_HOST=CHANGE_ME
AI_DB_NAME=ai_db
AI_DB_USERNAME=CHANGE_ME
AI_DB_PASSWORD=CHANGE_ME

# ---------- Prisma migrations (run from the laptop, not read by compose) ----------
# Direct (non-pooled) URLs of the demo branch, unquoted. The schema parameter decides where Prisma keeps _prisma_migrations:
# NOTIFICATION_MIGRATION_URL must end with ?schema=notification, AI_MIGRATION_URL with ?schema=ai (use &schema=... after an existing ?sslmode=require).
NOTIFICATION_MIGRATION_URL=CHANGE_ME
AI_MIGRATION_URL=CHANGE_ME

# ---------- Valkey (Aiven) ----------
# rediss:// URL, shared by identity (OTP), workspace (auth cache), workflow and the gateway (rate limits).
VALKEY_URL=CHANGE_ME

# ---------- Auth and internal secrets (generate each separately) ----------
# openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
# openssl rand -base64 48
JWT_REFRESH_SECRET=CHANGE_ME
# openssl rand -base64 48 (separate from the JWT secrets)
OTP_HMAC_SECRET=CHANGE_ME
# openssl rand -base64 48
IDENTITY_INTERNAL_SERVICE_KEY=CHANGE_ME
# openssl rand -base64 48 (at least 32 characters)
WEAV_INTERNAL_SERVICE_KEY=CHANGE_ME
# openssl rand -base64 48
WORKFLOW_INTERNAL_SERVICE_KEY=CHANGE_ME
# Base64 of exactly 32 bytes: openssl rand -base64 32 (new for this stack; never reuse the dev key)
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME

# ---------- RabbitMQ (fresh broker, no guest default) ----------
# openssl rand -hex 8 / openssl rand -base64 24
RABBITMQ_USERNAME=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME

# ---------- Google OAuth (one web client; both redirect URIs registered, see the runbook) ----------
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Mobile sign-in deep link; leave empty unless the partner rebuilds the app (weav://auth/callback).
OAUTH_MOBILE_RETURN_TARGET_URI=

# ---------- SMTP (Resend: smtp.resend.com, user "resend", key with sending access) ----------
SMTP_HOST=smtp.resend.com
SMTP_USERNAME=resend
SMTP_PASSWORD=CHANGE_ME
# Address on the verified domain, for example no-reply@weav.id.vn
SMTP_FROM_ADDRESS=CHANGE_ME

# ---------- Cloudflare R2 (S3-compatible; avatars/ and workflow-files/ prefixes share the bucket) ----------
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=CHANGE_ME
R2_BUCKET=CHANGE_ME
# R2 S3 API token with Object Read & Write on that bucket
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME

# ---------- DeepSeek (ai-service) ----------
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_MODEL=CHANGE_ME
